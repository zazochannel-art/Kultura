# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Rădăcina repo-ului ignoră package.json și package-lock.json (aplicația veche
# nu are pas de build). Aici sunt esențiale: fără ele `npm ci` nu are ce instala.
!package.json
!package-lock.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# capturi salvate de testul de fum când pică
/tests/failure.png
